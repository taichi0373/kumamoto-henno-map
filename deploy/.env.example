# k3s デプロイ設定（cp deploy/.env.example deploy/.env で作成。空欄は values ファイルの値を使う）

# ----- デプロイ先 -----
VALUES_FILE=values-home.yaml
# コミット SHA（ローカルでビルドしたイメージは local）
IMAGE_TAG=change-me
RELEASE_NAME=khm
NAMESPACE=khm

# ----- DB -----
# true: クラスタ内 PostgreSQL / false: 外部 DB
DB_ENABLED=
# Supabase は Session pooler の情報を使う（直接接続は IPv6 専用のため不可）
EXTERNAL_DB_HOST=
EXTERNAL_DB_PORT=
EXTERNAL_DB_NAME=
EXTERNAL_DB_USERNAME=
DB_PASSWORD=change-me

# ----- 秘密情報 -----
# 32 バイト以上（例: openssl rand -base64 48）
JWT_SECRET=change-me-to-random-string-at-least-32-bytes
RESEND_API_KEY=re_change-me
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
# 以下は任意
SLACK_WEBHOOK_URL=
# 3つ入力された場合のみ管理者を作成・上書きする
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=

# ----- Cloudflare Tunnel -----
CLOUDFLARED_TOKEN=change-me

# ----- DB バックアップ（Cloudflare R2） -----
DB_BACKUP_ENABLED=
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
