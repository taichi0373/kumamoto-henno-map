# =====================================================================
# k3s デプロイ設定（deploy/scripts/deploy.sh が読み込む）
# cp deploy/.env.example deploy/.env で複製して値を設定する（deploy/.env は Git 管理外）
# 書式: KEY=VALUE（シェルとしては実行しないため、値に $ や記号を含んでもよい）
# 空欄の項目は values ファイル（VALUES_FILE）の値が使われる
# =====================================================================

# ----- デプロイ先 -----
# =====================================================================

# ----- デプロイ先 -----
# 環境ごとの values ファイル（deploy/helm/kumamoto-henno-map/ 配下）
VALUES_FILE=values-home.yaml
# イメージタグ（publish-images.yml が付与するコミット SHA。ローカル検証でビルドしたイメージは local）
IMAGE_TAG=change-me
RELEASE_NAME=khm
NAMESPACE=khm

# ----- DB -----
# true: クラスタ内の PostgreSQL / false: 外部 DB（Supabase 等）
DB_ENABLED=
# DB_ENABLED=false のときの接続先（Supabase は Session pooler の情報を使う。直接接続のホストは IPv6 専用のため不可）
EXTERNAL_DB_HOST=
EXTERNAL_DB_PORT=
EXTERNAL_DB_NAME=
EXTERNAL_DB_USERNAME=
# DB パスワード（DB_ENABLED=true のときはクラスタ内 DB の初期パスワード）
DB_PASSWORD=change-me

# ----- アプリの秘密情報 -----
# 32 バイト以上のランダム文字列（例: openssl rand -base64 48）
JWT_SECRET=change-me-to-random-string-at-least-32-bytes
RESEND_API_KEY=re_change-me
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
# 任意
SLACK_WEBHOOK_URL=
# 任意（3つすべて設定したときのみ、起動時に管理者を作成・上書きする。共有 DB に接続する検証環境では設定しないこと）
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=

# ----- Cloudflare Tunnel（cloudflared.enabled=true のとき必須） -----
CLOUDFLARED_TOKEN=change-me

# ----- DB バックアップ（Cloudflare R2） -----
DB_BACKUP_ENABLED=
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
